<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Communication.Network.TCP.Shared</PackageId>
    <Version>2.7.0</Version>
    <Authors>BIGSUNGG</Authors>
    <Description>Shared TCP transport layer for DS_Communication: TcpSession, StreamByteChannel and TcpTransportOptions with optional TLS (SslStream, handshake timeout enforced). Transports expose only a byte channel — the application creates and owns sessions, and disconnection surfaces solely as Session.Disconnected(DisconnectReason). Targets .NET Standard 2.1 — runs on modern .NET and Unity.</Description>
    <RepositoryUrl>https://github.com/BIGSUNGG/DS_Communication.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Communication.Shared\Communication.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Communication.Network.TCP.Server" />
    <InternalsVisibleTo Include="Communication.Network.TCP.Client" />
    <InternalsVisibleTo Include="Communication.Tests" />
  </ItemGroup>

</Project>
